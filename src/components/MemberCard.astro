---
const { name, title, img, class: className } = Astro.props;
---

<div
  class="flex flex-col px-7 py-4 gap-3 rounded-xl bg-white/50 backdrop-blur-sm border border-amber-100 shadow-lg mx-auto w-full"
  class:list={[className]}
>
  <div class="flex justify-center">
    <img
      src={img}
      alt={name}
      class="w-40 h-40 object-cover rounded-full border-4 border-white shadow-sm"
    />
  </div>

  <div class="pt-3 flex flex-col items-center">
    <h4 class="text-lg font-semibold text-slate-900">{name}</h4>
    <p class="text-slate-500 text-sm">{title}</p>
  </div>
</div>
