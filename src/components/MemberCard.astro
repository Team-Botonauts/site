---
import "../styles/global.css";
const { name, title, img, class: className } = Astro.props;
---

<div
  class="grow flex flex-col px-3 md:px-6 py-4 gap-3 rounded-xl bg-white border border-amber-100
  max-w-50"
  class:list={[className]}
>
  <div class="flex justify-center">
    <img
      src={img}
      alt={name}
      class="w-30 h-30 md:w-40 md:h-40 object-cover rounded-full border-4 border-amber-200 shadow-lg min-w-fit"
    />
  </div>

  <div class="pt-3 flex flex-col items-center justify-center text-slate-500 font-body text-sm">
    <p class="text-sm md:text-lg font-semibold font-mono text-slate-900">{name}</p>
    <slot />
  </div>
</div>
