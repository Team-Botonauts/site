---
import "../styles/global.css";
import NavbarMenu from "../components/NavbarMenu.astro"
---

<nav
  class="flex py-1 px-4 fixed w-full backdrop-blur-md backdrop-brightness-50 z-20 h-14 items-center text-slate-100"
>
  <div class="flex justify-between w-full">
    <a
      class="group inline-flex items-center"
      href="/"
      rel="noopener noreferrer"
    >
      <img
        src="/images/botonauts_circle.png"
        alt="Botonauts Logo"
        class="w-6 h-6"
      />
      <span class="text-2xl font-black leading-relaxed tracking-wide uppercase pl-2 font-[Stint_Ultra_Condensed]">
        Botonauts
      </span>
    </a>

    <div class="flex sm:hidden items-center" id="menubtn">
      <span class="material-symbols-outlined text-3xl! select-none hover:text-gray-500 hover:cursor-pointer">
      menu
      </span>
    </div>

    <div class="sm:flex hidden gap-6 items-center font-mono uppercase">
      <a
        class="text-white hover:underline decoration-dotted underline-offset-4"
        href="/">Home
      </a>
      <a
        class="text-white hover:underline decoration-dotted underline-offset-4"
        href="/team">Meet The Team
      </a>
      <a
        class="text-white hover:underline decoration-dotted underline-offset-4"
        href="/robot">Our Robot
      </a>
    </div>
  </div>
</nav>
<NavbarMenu />
