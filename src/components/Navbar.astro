---
import "../styles/global.css";
---

<nav
  class="flex py-1 px-2 fixed w-full backdrop-blur-md backdrop-brightness-50 z-20 text-slate-100"
>
  <div class="flex justify-between w-full">
    <a
      class="group inline-flex items-center pl-2 sm:pl-5"
      href="/"
      rel="noopener noreferrer"
    >
      <img src="/favicon-32x32.png" alt="Botonauts Logo" class="w-6 h-6" />
      <span
        class="text-2xl font-black leading-relaxed uppercase py-1 px-2 font-[Stint_Ultra_Condensed]"
      >
        Botonauts
      </span>
    </a>
    <div
      class="flex gap-3 sm:gap-6 items-center px-2 sm:px-5 font-[Jetbrains_Mono] uppercase"
    >
      <a
        class="text-white hover:underline decoration-dotted
           underline-offset-4"
        href="/">Home</a
      >
      <a
        class="text-white hover:underline decoration-dotted
           underline-offset-4"
        href="/team">Meet The Team</a
      >
      <a
        class="text-white hover:underline decoration-dotted
           underline-offset-4"
        href="/">Our Robot</a
      >
    </div>
  </div>
</nav>
