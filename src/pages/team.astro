---
import MemberCard from "../components/MemberCard.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro"
import PageHead from "../components/PageHead.astro";
import "../styles/global.css";
---

<html lang="en">
  <PageHead>Botonauts FTC Team - Meet the Team</PageHead>

  <body>
    <main>
      <Navbar />
      <section
        class="relative flex min-h-60 md:min-h-105 items-center justify-center
         bg-[url('/images/group_banner.jpg')] bg-cover 2xl:bg-size-[70%_auto] bg-center px-6"
      >
        <div class="absolute inset-0 bg-black/50"></div>
        <div class="relative text-center text-white">
          <h2
            class="pt-20 text-4xl font-bold font-mono uppercase sm:text-5xl lg:text-6xl"
          >
            Meet the Team
          </h2>
        </div>
      </section>
      <section
        class="min-h-screen flex justify-center items-stretch bg-linear-to-br from-slate-300 via-amber-200 to-[#FB752D] px-5 py-20 text-black"
      >
        <div class="flex flex-wrap max-w-4xl gap-3 sm:gap-6 justify-center h-fit">
          <MemberCard name="Arthur Ramsden" img="/images/team/arthur.jpg"><p>Engineering Lead</p><p>CAD Technician</p></MemberCard>
          <MemberCard name="Edward Thomas" img="/images/team/edward.jpg"><p>Intake Engineer</p><p>Driver</p></MemberCard>
          <MemberCard name="Henry Mann" img="/images/team/henry.jpg"><p>Project Manager</p><p>Software Developer</p></MemberCard>
          <MemberCard name="Nicolet Pegler" img="/images/team/nicolet.jpg"><p>Portfolio Lead</p><p>Social Media</p></MemberCard>
          <MemberCard name="Samantha Collier" img="/images/team/samantha.jpg"><p>Outreach Lead</p></MemberCard>
          <MemberCard name="Samuel Gregory" img="/images/team/samuel.jpg"><p>Outtake Engineer</p></MemberCard>
          <MemberCard name="Thomas Edwards" img="/images/team/thomas.jpg"><p>Web Lead</p><p>CAD Technician</p></MemberCard>
        </div>
      </section>
      <Footer />
    </main>
  </body>
</html>
