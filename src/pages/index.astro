---
import Link from "../components/Link.astro";
import Navbar from "../components/Navbar.astro";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=location_on,arrow_outward"
    />

    <link rel="manifest" href="/site.webmanifest" />
    <title>Botonauts FTC Team</title>
  </head>

  <body>
    <main>
      <Navbar />
      <section
        class="relative flex min-h-screen items-center justify-center bg-[url('/images/team.jpg')] bg-cover bg-center px-6"
      >
        <div class="absolute inset-0 bg-black/50"></div>
        <div class="relative text-center text-white">
          <h2 class="text-lg uppercase text-slate-300 font-semibold">We are</h2>
          <h1
            class="text-7xl sm:text-8xl lg:text-9xl font-black pb-4 uppercase"
          >
            Botonauts
          </h1>
          <div
            class="flex flex-col sm:flex-row items-center justify-center sm:justify-between gap-3 sm:gap-7"
          >
            <div class="group inline-flex items-center">
              <span class="material-symbols-outlined pr-1"> location_on </span>
              <h2 class="text-xl font-semibold">Wiltshire, UK</h2>
            </div>

            <h2 class="text-xl font-semibold text-slate-300">
              FTC Team #28578
            </h2>
          </div>
        </div>
        <Link
          href="https://ftcscout.org/teams/28578"
          newtab="true"
          external="true"
          variant="gray"
          class="absolute bottom-8 left-1/2 -translate-x-1/2"
        >
          FTCScout
        </Link>
      </section>

      <section class="bg-orange-300 px-6 py-20 sm:px-12 lg:px-20">
        <div class="mx-auto grid w-full max-w-7xl gap-12 md:grid-cols-2">
          <div>
            <h2 class="text-4xl sm:text-5xl lg:text-6xl font-bold uppercase">
              About Us
            </h2>
          </div>
          <div>
            <p class="text-lg sm:text-xl font-normal leading-relaxed">
              Lorem ipsum dolor sit amet, consectetur adipiscing elit.
              Vestibulum sem turpis, lacinia ullamcorper arcu a, sagittis
              egestas diam. Integer hendrerit neque vitae nunc congue aliquam.
              Nullam laoreet quam ac urna lacinia commodo vel vitae est. Nam
              iaculis a mauris in varius. Pellentesque risus tortor, hendrerit
              eu rutrum et, auctor sed velit. Aenean volutpat aliquet efficitur.
              Pellentesque habitant morbi tristique senectus et netus et
              malesuada fames ac turpis egestas.
            </p>
            <Link href="/team" newtab="false" variant="black" class="pt-6"
              >Meet The Team</Link
            >
          </div>
        </div>
      </section>

      <section class="bg-slate-100 px-6 py-20 sm:px-12 lg:px-20">
        <div class="mx-auto grid w-full max-w-7xl gap-12 md:grid-cols-2">
          <div class="md:order-2">
            <h2
              class="text-4xl sm:text-5xl lg:text-6xl font-bold uppercase md:text-right"
            >
              Our Robot
            </h2>
          </div>
          <div class="md:order-1">
            <p class="text-lg sm:text-xl font-normal leading-relaxed">
              Lorem ipsum dolor sit amet, consectetur adipiscing elit.
              Vestibulum sem turpis, lacinia ullamcorper arcu a, sagittis
              egestas diam. Integer hendrerit neque vitae nunc congue aliquam.
              Nullam laoreet quam ac urna lacinia commodo vel vitae est. Nam
              iaculis a mauris in varius. Pellentesque risus tortor, hendrerit
              eu rutrum et, auctor sed velit. Aenean volutpat aliquet efficitur.
              Pellentesque habitant morbi tristique senectus et netus et
              malesuada fames ac turpis egestas.
            </p>
            <Link href="/" newtab="false" variant="black" class="pt-6"
              >Learn More</Link
            >
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
