---
import Footer from "../components/Footer.astro"
import Navbar from "../components/Navbar.astro";
import PageHead from "../components/PageHead.astro";
import "../styles/global.css";
---

<html lang="en">
    <PageHead>Botonauts FTC Team - Our Robot</PageHead>
    <body>
        <main>
            <Navbar />
            <section
                class="bg-linear-to-br from-white via-[#8FC9D4] to-[#07657F] px-5 py-20 text-black"
            >
                <div class="relative text-center">
                    <h2
                        class="pt-20 text-4xl font-bold font-mono uppercase sm:text-5xl lg:text-6xl"
                    >
                        Our Robot
                    </h2>
                </div>
            </section>
            <section class="px-5 py-20 min-h-screen">
                <div class="mx-auto grid w-full max-w-7xl gap-5 md:grid-cols-2">
                    <div>
                        <img
                            src="/images/robot01.jpg"
                            alt="placeholder"
                            class="w-lg h-lg"
                        />
                    </div>
                    <div>
                        <p
                            class="text-lg sm:text-xl font-normal leading-relaxed"
                        >
                            This is our robot. It is currently a
                            work-in-progress, so stay tuned to our social media
                            for updates!
                        </p>
                    </div>
                </div>
            </section>
            <Footer />
        </main>
    </body>
</html>
